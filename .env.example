# Model providers and API keys are configured per user in Settings, not here.

# Optional: public site URL (used for og:image/og:url), e.g. https://happier.chat
VITE_SITE_URL=

# Optional: secret for encrypting stored provider API keys.
# Defaults to a random secret generated once into .data/secret; keep it stable or saved keys become unreadable.
APP_SECRET=

# Optional: server port and host (default 3000 in dev; `pnpm start` listens on all interfaces)
PORT=
HOST=

# Optional: self-hosted SearXNG for the web_search tool (docker, see searxng/settings.yml)
SEARXNG_URL=

# Optional: Durable Streams server so in-flight replies survive reloads and restarts.
# Start one locally with `pnpm streams`; unset keeps runs in memory.
DURABLE_STREAMS_URL=
# Used by `pnpm streams` only
DURABLE_STREAMS_PORT=4437
DURABLE_STREAMS_DATA_DIR=.data/streams

# Development only: one-click demo login on the login page
DEBUG_HAPPIER_CHAT_SHOW_DEMO_ACCOUNT=
DEBUG_HAPPIER_CHAT_SHOW_DEMO_EMAIL=
DEBUG_HAPPIER_CHAT_SHOW_DEMO_PASSWORD=

# Development only: ADMIN_EMAIL becomes admin on signup while no admin exists, and with the debug flag
# above the login page offers a one-click admin login using ADMIN_PASSWORD.
# In production create the admin with `node scripts/create-user.mjs --admin <email>`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
